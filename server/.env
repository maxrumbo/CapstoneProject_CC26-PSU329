# 1. KONEKSI DATABASE (Data Asli pgAdmin)
# Format: postgresql://[user]:[password]@[host]:[port]/[nama_db]
DATABASE_URL=postgresql://postgres:123@localhost:5432/sawit_db

# 2. KEAMANAN JWT (Inisiasi Mandiri untuk Sistem Auth)
# Kunci rahasia bebas/acak (digunakan untuk mengenkripsi token login)
SECRET_KEY=maxrumbo_SAWIT

# Algoritma enkripsi standar sesuai Guideline Step 1.2
ALGORITHM=HS256

# Masa aktif login user (1440 menit = 24 jam)
ACCESS_TOKEN_EXPIRE_MINUTES=1440